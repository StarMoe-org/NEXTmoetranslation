# ---- moesekai v2 server configuration ----
# Copy to .env and fill in. Settings marked (seed) are written to the DB on
# first run only; afterward the admin UI is authoritative.

# --- Required ---
# Enables fail-closed production startup checks. Production requires a stable
# MOESEKAI_MASTER_KEY and at least one initialized administrator.
MOESEKAI_PRODUCTION=true
# Secret used to sign JWT session tokens. Use a long random string.
JWT_SECRET=replace-with-at-least-32-random-bytes
# Master key for encrypting secret settings (LLM keys, backup credentials) at
# rest in SQLite. Production requires at least 32 bytes of secret material.
# Generate once with: openssl rand -base64 32
# Store it in the deployment secret manager and keep it stable across restarts.
MOESEKAI_MASTER_KEY=replace-with-at-least-32-random-bytes

# --- Server ---
PORT=8080
# Production container paths. For local `go run`, override both with ./data/...
# instead of passing this file unchanged to a process running outside Docker.
DB_PATH=/data/moesekai.db
DATA_DIR=/data
# The standalone production image pins this exact root-owned console path.
# Do not override it to /data, /, or an external mount.
WEB_DIR=/app/web
# Standalone production pins UTC and rejects unset, case-varied, or other zones.
TZ=UTC
# Production must select the exact standalone mode `disabled`; both legacy
# workspace variables must remain unset, including empty-valued entries.
# `external` is retained only for nonproduction verifier tooling and requires
# both variables below.
WORKSPACE_MODE=disabled
# WORKSPACE_WEB_DIR=/app/workspace
# WORKSPACE_MANIFEST_SHA256=replace-with-the-64-character-lowercase-manifest-sha256
# Allowed origin for the console API (CORS). The default wildcard supports
# platform-assigned production domains; set one exact origin to restrict access.
CONSOLE_ORIGIN=*
# Session lifetime in canonical integer hours. Startup rejects values outside
# 1..720; 168 = 7 days and 720 = 30 days.
TOKEN_TTL_HOURS=168
# One total shutdown deadline, including a short HTTP drain followed by worker
# cancellation, forced connection close, and joins before SQLite closes.
SHUTDOWN_BUDGET_MS=25000
SHUTDOWN_DRAIN_MS=2000

# --- Yjs lyrics collaboration ---
# No extra secret or runtime is required. The browser uses the long-lived JWT
# only in the Authorization header of
# POST /api/editor/v1/lyrics/{musicId}/collab-ticket, then connects to
# /yjs/lyrics/{musicId}?ticket=<45-second-one-time-ticket>. Never put the JWT in
# a Yjs WebSocket query string. The client uses a fixed 15-second Yjs resync so
# a healthy single-editor room stays below y-websocket's silence watchdog.
#
# Collaboration resource limits are intentionally code-owned, not env knobs:
# 50 connections, 10 peers/room, 256 rooms (128 resident), 8 MiB raw
# update/merged-document cap plus 64 KiB message framing headroom, 100000
# pending items, 20 messages/s with burst 40, peer write queue 256,
# 256 KiB awareness and 256 awareness clients/room,
# 10 s handshake, 90 s awareness expiry, 5 min idle eviction, persistence
# coalesce max wait 1 s, and compaction every 100 successful flushes.
# Reverse proxies must preserve WebSocket Upgrade and the /yjs/lyrics/* path;
# they must not log query strings containing the short ticket.

# --- Administrator bootstrap/recovery (used only when no administrator exists) ---
# Inject this secret only for the controlled bootstrap/recovery start. After the
# administrator is persisted and verified, remove ADMIN_PASSWORD from the
# long-lived container environment so an accidentally empty volume cannot reuse it.
# Uncomment only for the controlled bootstrap start and replace both values.
# The published password template is explicitly rejected by the server.
# ADMIN_USER=admin
# ADMIN_PASSWORD=replace-with-12-or-more-characters
# Or legacy-style. The first account that passes validation and is created
# successfully becomes admin; later valid accounts become editors.
# TRANSLATOR_ACCOUNTS=admin:strong-password-1,editor:strong-password-2

# --- LLM (seed) ---
LLM_TYPE=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Per-request hard timeout and retry count. Successful story batches are saved
# immediately, so a later timeout can resume without starting over.
LLM_REQUEST_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2
TRANSLATE_BATCH_SIZE=20
TRANSLATE_RATE_DELAY_MS=800

# --- Upstream update detection (seed) ---
# Configured public sources must be absolute HTTPS URLs on port 443 without
# credentials, query strings, fragments, or control characters. DNS is resolved
# and pinned at dial time; private, loopback, link-local, CGNAT, ULA, and
# multicast answers are rejected.
UPSTREAM_REPO=Team-Haruki/haruki-sekai-master
UPSTREAM_BRANCH=main
# Version detection URL. Empty uses the metadata.pjsk.moe mirror below; templates may
# use {repo} and {branch}, for example a jsDelivr GitHub CDN URL.
UPSTREAM_VERSION_URL=https://metadata.pjsk.moe/jp/versions/current_version.json
# Comma-separated custom fallbacks. GitHub Raw, Fastly, Gcore and jsDelivr
# rescue URLs are also appended automatically.
UPSTREAM_VERSION_FALLBACK_URL=https://raw.githubusercontent.com/{repo}/{branch}/versions/current_version.json
# Masterdata and scenario sources. Templates may use {repo} and {branch}.
UPSTREAM_JP_MASTERDATA_URL=https://metadata.pjsk.moe/jp/master
UPSTREAM_JP_MASTERDATA_FALLBACK_URL=https://raw.githubusercontent.com/{repo}/{branch}/master
UPSTREAM_CN_MASTERDATA_URL=https://metadata.pjsk.moe/cn/master
UPSTREAM_CN_MASTERDATA_FALLBACK_URL=https://sekaimaster-cn.exmeaning.com/master
# assets.unipjsk.com is primary because snowyassets.exmeaning.com currently
# returns HTTP 525. Leave a fallback empty unless another healthy mirror exists.
UPSTREAM_JP_ASSETS_URL=https://assets.unipjsk.com/ondemand
UPSTREAM_JP_ASSETS_FALLBACK_URL=
UPSTREAM_CN_ASSETS_URL=https://sekai-assets-bdf29c81.seiunx.net/cn-assets/ondemand
UPSTREAM_CN_ASSETS_FALLBACK_URL=
# Card story and area talk sources: EN masterdata plus the JP/CN/EN startapp
# script bases. The JP fallback serves card scripts only; CN and EN have no
# fallback. Do not point CN or EN at a mirror that answers with Japanese text.
# Checked on every start before the database is opened, as given, by the
# validator that seeds them: an unsafe URL, a control character (a trailing
# carriage return included) or a value over 8192 bytes stops startup naming
# the variable.
UPSTREAM_EN_MASTERDATA_URL=https://metadata.pjsk.moe/en/master
UPSTREAM_EN_MASTERDATA_FALLBACK_URL=https://raw.githubusercontent.com/Team-Haruki/haruki-sekai-en-master/main/master
UPSTREAM_JP_SCRIPTS_URL=https://storage.exmeaning.com/sekai-jp-assets
UPSTREAM_JP_SCRIPTS_FALLBACK_URL=https://assets.unipjsk.com/startapp
UPSTREAM_CN_SCRIPTS_URL=https://sekai-assets-bdf29c81.seiunx.net/cn-assets/startapp
UPSTREAM_EN_SCRIPTS_URL=https://storage.exmeaning.com/sekai-en-assets
# Maximum concurrent upstream downloads (clamped to 1-12, default 4).
UPSTREAM_FETCH_CONCURRENCY=4
# Legacy CN polling/sync is opt-in. When false or unset, startup performs no
# version baseline/pending-state writes and no scheduled CN content sync. An
# admin's manual upstream check (or a CN sync of a version it detected) still
# records the data version, and the side-story backfill then refreshes its
# catalog in the next round.
TRANSLATE_SCHEDULER_ENABLED=false
# Card story and area talk backfill. It runs while SIDE_STORY_BACKFILL_ENABLED
# is not false (unset or empty means true) and the admin setting
# side_story_backfill.enabled is not false; scheduler.enabled does not gate it.
# It never calls an LLM. Set false to keep it off; turning it on again needs
# this env and a restart, the admin setting cannot override it. Validated on
# every start before the database is opened: interval = wait after a round
# ends before the next starts 1000-86400000 ms (default 60000), batch = episodes
# per round 1-500 (default 30), delay between the background rounds' upstream
# requests 100-60000 ms (default 1000; an admin refresh and the TXT-import
# snapshot are not paced).
SIDE_STORY_BACKFILL_ENABLED=true
SIDE_STORY_BACKFILL_INTERVAL_MS=60000
SIDE_STORY_BACKFILL_BATCH=30
SIDE_STORY_BACKFILL_REQUEST_DELAY_MS=1000
# Development/test only: permits loopback HTTP and local httptest ports for the
# upstream data clients. Production rejects true; public upstreams always require
# HTTPS, public DNS answers, and the standard HTTPS port.
UPSTREAM_ALLOW_INSECURE_LOCAL=false

# Private lyrics-source workers are independently default-off. These values seed
# authenticated settings only when absent; changing settings requires restart.
LYRICS_DISCOVERY_ENABLED=false
LYRICS_FETCH_REVISION_ENABLED=false
LYRICS_DISCOVERY_SCAN_MS=21600000
LYRICS_DISCOVERY_LEASE_MS=120000
LYRICS_DISCOVERY_JOB_TIMEOUT_MS=30000
LYRICS_DISCOVERY_IDLE_MS=2000
LYRICS_DISCOVERY_RETRY_MIN_MS=30000
LYRICS_DISCOVERY_RETRY_MAX_MS=1800000
LYRICS_DISCOVERY_CONCURRENCY=4
LYRICS_FETCH_REVISION_LEASE_MS=120000
LYRICS_FETCH_REVISION_JOB_TIMEOUT_MS=30000
LYRICS_FETCH_REVISION_IDLE_MS=2000
LYRICS_FETCH_REVISION_RETRY_MIN_MS=30000
LYRICS_FETCH_REVISION_RETRY_MAX_MS=1800000
LYRICS_FETCH_REVISION_CONCURRENCY=4

# Poll interval for current_version.json, in ms (default 1 hour).
UPSTREAM_POLL_MS=3600000
# Maintain a local git clone of the masterdata repo for sync work. Version
# detection uses UPSTREAM_VERSION_URL and backs off automatically on 429.
UPSTREAM_USE_GIT=false

# --- GitHub backup (seed) ---
# Store any authenticated repository URL only in the encrypted settings store or
# deployment secret manager. Never commit a credential-bearing URL to this file.
GIT_PUSH_REPO_URL=
GIT_PUSH_BRANCH=backup-translations

# --- S3 backup (seed) ---
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Public file rebuild debounce (ms, 100-86400000; invalid stops startup) ---
# A debounced rebuild waits one window after the latest change, at most two in all.
FILES_REBUILD_DEBOUNCE_MS=300000

# --- Search index refresh (ms) ---
# A debounced build waits one window after the latest change, at most two in all.
SEARCH_INDEX_DEBOUNCE_MS=3600000
SEARCH_INDEX_REFRESH_MS=3600000
# Failed startup and refresh builds retry exponentially within these bounds.
SEARCH_INDEX_RETRY_MIN_MS=5000
SEARCH_INDEX_RETRY_MAX_MS=300000

# --- GitHub Actions standalone release configuration (not container environment) ---
# Configure these as repository variables consumed by protected push CI, not in
# this file, the `production` environment, or the runtime container. Release
# promotes the exact tested CI candidate and does not rebuild from these values.
# See STANDALONE_RELEASE.md for permissions and scope.
# Variables: NODE_IMAGE_DIGEST, GO_IMAGE_DIGEST, RUNTIME_IMAGE,
#            RUNTIME_IMAGE_DIGEST
# Optional variable: GITHUB_ARTIFACT_ATTESTATIONS_ENABLED=true only when private
# repository artifact attestations are supported. A broad PAT is not permitted.
# Protected `production` environment only (never container env or repository-wide):
# GHCR_RELEASE_USERNAME=<dedicated package-writer account>
# GHCR_RELEASE_TOKEN=<revocable least-privilege GHCR writer credential>
